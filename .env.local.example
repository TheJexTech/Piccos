# Supabase project URL and anon (public) key.
# Safe to expose to the browser — RLS policies enforce authorization.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only. Bypasses RLS entirely.
# NEVER prefix with NEXT_PUBLIC_, never import from client components.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for Ask Piccos (added in M12). Server-only.
ANTHROPIC_API_KEY=
