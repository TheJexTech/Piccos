# Supabase project URL and anon (public) key.
# Safe to expose to the browser — RLS policies enforce authorization.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of this app, used to build email confirmation / password reset
# links. Must also be added to the Supabase project's allowed Redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service role key — server-only. Bypasses RLS entirely.
# NEVER prefix with NEXT_PUBLIC_, never import from client components.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for Ask Piccos (added in M12). Server-only.
ANTHROPIC_API_KEY=
